transmute(query, xmin_plot = 1, xmax_plot = pmin(window_bp, contig_end)),
contig_plot_info %>%
filter(contig_end > window_bp) %>%
transmute(
query,
xmin_plot = pmax(contig_end - window_bp + 1 - shift, 1),
xmax_plot = contig_end - shift
)
)
View(contig_windows_plot)
repeats_telo_with_contig <- repeats_telo %>%
left_join(contig_plot_info, by = "query")
repeats_telo_left <- repeats_telo_with_contig %>%
mutate(xmin_plot = pmax(q_start, 1), xmax_plot = pmin(q_end, window_bp)) %>%
filter(xmin_plot <= xmax_plot)
repeats_telo_right <- repeats_telo_with_contig %>%
filter(contig_end > window_bp) %>%
mutate(
right_start = contig_end - window_bp + 1,
xmin_plot = pmax(q_start, right_start) - shift,
xmax_plot = pmin(q_end, contig_end) - shift
) %>%
filter(xmin_plot <= xmax_plot)
repeats_telo_ends <- bind_rows(repeats_telo_left, repeats_telo_right)
ggplot() +
# Draw the background bar for each contig
geom_rect(data = contig_windows_plot,
aes(xmin = xmin_plot, xmax = xmax_plot, ymin = -0.4, ymax = 0.4),
fill = "grey95", color = "grey85", linewidth = 0.2) +
# Draw the repeats
geom_rect(data = repeats_telo_ends,
aes(xmin = xmin_plot, xmax = xmax_plot, ymin = -0.4, ymax = 0.4, fill = repeat_name),
alpha = 1) +
facet_wrap(~query, ncol = 1, strip.position = "left", scales = "free_x") +
# Styling
#scale_fill_manual(values = custom_palette) +
scale_fill_muted() +
theme_minimal(base_size = 16) +
labs(
title = "Comparative Repeat Landscape",
subtitle = "telomere",
x = "Position in 5' and 3' 500 kb windows (bp)",
fill = "Repeat Class"
) +
theme(
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank(),
strip.text.y.left = element_text(angle = 0, face = "bold", size = 12),
legend.position = "bottom",
# Add space between facets to make individual scales clearer
panel.spacing = unit(1, "lines")
)
View(repeats_telo_ends)
